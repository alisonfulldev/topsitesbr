generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  client
}

enum SiteType {
  mini_site
  landing_page
  institucional
  loja_virtual
}

enum SiteStatus {
  pendente_ativacao
  online
  offline
  manutencao
  suspenso
}

enum DnsStatus {
  pendente
  verificado
  falhou
}

enum SslStatus {
  pendente
  ativo
  falhou
}

enum SubscriptionStatus {
  pending
  active
  overdue
  canceled
}

enum InvoiceStatus {
  pending
  paid
  overdue
}

enum ProductType {
  upgrade_site
  service
  addon
  whatsapp_lead
}

enum DiscountType {
  percent
  fixed
}

enum OrderStatus {
  pending
  paid
  delivered
}

enum ChangeType {
  texto
  imagem
  texto_e_imagem
  correcao
  nova_secao
  nova_pagina
  duvida
  outro
}

enum TicketStatus {
  open
  in_progress
  done
}

enum NotificationChannel {
  painel
  email
  whatsapp
}

enum CostCategory {
  ia
  trafego_pago
  hospedagem_ferramentas
  outro
}

enum ExtraRevenueCategory {
  servico_avulso
  consultoria
  venda_site
  outro
}

enum ReferralStatus {
  confirmado
  recompensado
}

enum ProposalStatus {
  rascunho
  enviada
  aprovada
  paga
  aguardando_info
  em_desenvolvimento
  pronto_revisao
  publicado
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Client {
  id                       String    @id @default(uuid())
  name                     String
  email                    String    @unique
  phone                    String?
  document                 String?
  referralCode             String    @unique
  siteEntryFee             Decimal?  @map("site_entry_fee") @db.Decimal(10, 2)
  monthlyFeeAcknowledgedAt DateTime?
  downloadRetentionShownAt DateTime?
  termsAcceptedAt          DateTime? @map("terms_accepted_at")
  termsVersion             String?   @map("terms_version")
  activationFlow           String    @default("frio") @map("activation_flow")
  entryFlow                String    @default("whatsapp") @map("entry_flow")
  asaasCustomerId          String?   @map("asaas_customer_id")
  lastReferralPromptAt     DateTime? @map("last_referral_prompt_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  users             User[]
  sites             Site[]
  subscriptions     Subscription[]
  orders            Order[]
  tickets           Ticket[]
  notifications     Notification[]
  referralsGiven    Referral[]          @relation("ReferrerClient")
  referralReceived  Referral?           @relation("ReferredClient")
  planChangeHistory PlanChangeHistory[]
  siteReports       SiteReport[]
  pushSubscriptions PushSubscription[]
  proposals         Proposal[]

  @@map("clients")
}

model User {
  id                 String    @id @default(uuid())
  clientId           String?   @map("client_id")
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  client               Client?              @relation(fields: [clientId], references: [id])
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Site {
  id              String     @id @default(uuid())
  clientId        String     @map("client_id")
  siteUrl         String?    @map("site_url")
  siteType        SiteType   @map("site_type")
  templateUsed    String?    @map("template_used")
  status          SiteStatus @default(pendente_ativacao)
  publishedAt     DateTime?  @map("published_at")
  filesZipUrl     String?    @map("files_zip_url")
  analyticsSiteId    String?    @map("analytics_site_id")
  visitPushMilestone Int        @default(0) @map("visit_push_milestone")
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id])
  domains   Domain[]
  tickets   Ticket[]
  reports   SiteReport[]
  pageViews PageView[]
  proposal  Proposal?

  @@map("sites")
}

model PageView {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  path      String   @default("/")
  referrer  String?
  sessionId String   @map("session_id")
  timestamp DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, timestamp])
  @@index([siteId, sessionId])
  @@map("page_views")
}

model Domain {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  domain     String
  dnsStatus  DnsStatus @default(pendente) @map("dns_status")
  sslStatus  SslStatus @default(pendente) @map("ssl_status")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])

  @@map("domains")
}

model Plan {
  id                     String   @id @default(uuid())
  name                   String   @unique
  price                  Decimal  @db.Decimal(10, 2)
  monthlyChangesIncluded Int      @map("monthly_changes_included")
  prioritySupport        Boolean  @default(false) @map("priority_support")
  allowedChangeTypes     String   @default("") @map("allowed_change_types")
  changeDeadlineDays     Int      @default(7) @map("change_deadline_days")
  discountPercent        Int      @default(0) @map("discount_percent")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  subscriptions     Subscription[]
  planChangesFrom   PlanChangeHistory[] @relation("PlanChangeFrom")
  planChangesTo     PlanChangeHistory[] @relation("PlanChangeTo")

  @@map("plans")
}

model Subscription {
  id                  String             @id @default(uuid())
  clientId            String             @map("client_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(active)
  asaasSubscriptionId String?            @map("asaas_subscription_id")
  nextDueDate         DateTime?          @map("next_due_date")
  planActivatedAt     DateTime           @default(now()) @map("plan_activated_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                  String        @id @default(uuid())
  subscriptionId      String        @map("subscription_id")
  amount              Decimal       @db.Decimal(10, 2)
  status              InvoiceStatus @default(pending)
  dueDate             DateTime      @map("due_date")
  paidAt              DateTime?     @map("paid_at")
  asaasChargeId       String?       @map("asaas_charge_id")
  overdueDay0SentAt   DateTime?     @map("overdue_day0_sent_at")
  overdueDay5SentAt   DateTime?     @map("overdue_day5_sent_at")
  overdueDay10SentAt  DateTime?     @map("overdue_day10_sent_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

model Product {
  id               String    @id @default(uuid())
  name             String
  price            Decimal   @db.Decimal(10, 2)
  type             ProductType
  eligibleSiteTypes String?   @map("eligible_site_types")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  orders     Order[]
  promotions Promotion[]

  @@map("products")
}

model Promotion {
  id            String       @id @default(uuid())
  productId     String?      @map("product_id")
  title         String
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @db.Decimal(10, 2) @map("discount_value")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id])

  @@map("promotions")
}

model Order {
  id            String      @id @default(uuid())
  clientId      String      @map("client_id")
  productId     String      @map("product_id")
  amount        Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(pending)
  asaasChargeId String?     @map("asaas_charge_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  client   Client   @relation(fields: [clientId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  proposal Proposal?

  @@map("orders")
}

model Ticket {
  id            String       @id @default(uuid())
  clientId      String       @map("client_id")
  siteId        String       @map("site_id")
  changeType    ChangeType   @map("change_type")
  textContent   String?      @map("text_content")
  attachmentUrl String?      @map("attachment_url")
  status        TicketStatus @default(open)
  isExtraPaid   Boolean      @default(false) @map("is_extra_paid")
  isPriority    Boolean      @default(false) @map("is_priority")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])

  @@map("tickets")
}

model Notification {
  id        String              @id @default(uuid())
  clientId  String?             @map("client_id")
  title     String
  message   String
  channel   NotificationChannel
  read      Boolean             @default(false)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id])

  @@map("notifications")
}

model Cost {
  id                  String       @id @default(uuid())
  category            CostCategory
  description         String
  amount              Decimal      @db.Decimal(10, 2)
  costDate            DateTime     @map("cost_date")
  isRecurring         Boolean      @default(false) @map("is_recurring")
  recurrenceFrequency String?      @map("recurrence_frequency")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@map("costs")
}

model Referral {
  id               String         @id @default(uuid())
  referrerClientId String         @map("referrer_client_id")
  referredClientId String         @unique @map("referred_client_id")
  status           ReferralStatus @default(confirmado)
  rewardMonths     Int            @default(1) @map("reward_months")
  rewardedAt       DateTime?      @map("rewarded_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  referrerClient Client @relation("ReferrerClient", fields: [referrerClientId], references: [id])
  referredClient Client @relation("ReferredClient", fields: [referredClientId], references: [id])

  @@map("referrals")
}

model ReferralClick {
  id           String   @id @default(uuid())
  referralCode String   @map("referral_code")
  clickedAt    DateTime @default(now()) @map("clicked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("referral_clicks")
}

model PlanChangeHistory {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  fromPlanId       String   @map("from_plan_id")
  toPlanId         String   @map("to_plan_id")
  changedAt        DateTime @default(now()) @map("changed_at")
  wasManualOverride Boolean  @default(false) @map("was_manual_override")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client   Client @relation(fields: [clientId], references: [id])
  fromPlan Plan   @relation("PlanChangeFrom", fields: [fromPlanId], references: [id])
  toPlan   Plan   @relation("PlanChangeTo", fields: [toPlanId], references: [id])

  @@map("plan_change_history")
}

model AllocationFixedCost {
  id     String  @id @default(uuid())
  name   String
  amount Decimal @db.Decimal(10, 2)
  order  Int     @default(0)

  @@map("allocation_fixed_costs")
}

model AllocationRule {
  id      String  @id @default(uuid())
  name    String
  percent Decimal @db.Decimal(5, 2)
  color   String  @default("#6b7280")
  order   Int     @default(0)

  @@map("allocation_rules")
}

model ExtraRevenue {
  id          String               @id @default(uuid())
  category    ExtraRevenueCategory
  description String
  amount      Decimal              @db.Decimal(10, 2)
  revenueDate DateTime             @map("revenue_date") @db.Date
  createdAt   DateTime             @default(now()) @map("created_at")

  @@map("extra_revenues")
}

model SiteReport {
  id          String    @id @default(uuid())
  siteId      String    @map("site_id")
  clientId    String    @map("client_id")
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  generatedAt DateTime  @default(now()) @map("generated_at")
  viewedAt    DateTime? @map("viewed_at")
  archivedAt  DateTime? @map("archived_at")
  data        Json
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  site   Site   @relation(fields: [siteId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@map("site_reports")
}

model PushSubscription {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Proposal {
  id             String         @id @default(uuid())
  clientId       String         @map("client_id")
  siteId         String?        @unique @map("site_id")
  title          String
  description    String?
  includedItems  String?        @map("included_items")
  creationPrice  Decimal        @db.Decimal(10, 2) @map("creation_price")
  status         ProposalStatus @default(rascunho)
  asaasChargeId  String?        @map("asaas_charge_id")
  paymentUrl     String?        @map("payment_url")
  orderId        String?        @unique @map("order_id")
  previewUrl     String?        @map("preview_url")
  revisionUsed         Boolean        @default(false) @map("revision_used")
  revisionNotes        String?        @map("revision_notes")
  approvedAt           DateTime?      @map("approved_at")
  siteApprovedAt       DateTime?      @map("site_approved_at")
  paidAt               DateTime?      @map("paid_at")
  contractAcceptedAt   DateTime?      @map("contract_accepted_at")
  contractVersion      String?        @map("contract_version")
  contractAcceptedIp   String?        @map("contract_accepted_ip")
  paidExternally       Boolean        @default(false) @map("paid_externally")
  briefingSkipped      Boolean        @default(false) @map("briefing_skipped")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client               Client               @relation(fields: [clientId], references: [id])
  site                 Site?                @relation(fields: [siteId], references: [id])
  order                Order?               @relation(fields: [orderId], references: [id])
  accessTokens         ProposalAccessToken[]
  briefing             Briefing?
  presentationProposal PresentationProposal?

  @@map("proposals")
}

model ProposalAccessToken {
  id         String    @id @default(uuid())
  proposalId String    @map("proposal_id")
  clientId   String    @map("client_id")
  tokenHash  String    @unique @map("token_hash")
  purpose    String    @default("view")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_access_tokens")
}

model Briefing {
  id          String   @id @default(uuid())
  proposalId  String   @unique @map("proposal_id")
  data        Json
  submittedAt DateTime @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("briefings")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model TermsVersion {
  version   String   @id
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("terms_versions")
}

enum ProjectLabel {
  urgente
  normal
}

enum ProjectStatus {
  a_fazer
  em_desenvolvimento
  em_revisao
  concluido
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  label       ProjectLabel  @default(normal)
  status      ProjectStatus @default(a_fazer)
  dueDate     DateTime      @map("due_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  source    String   @default("landing")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model PresentationProposal {
  id         String    @id @default(uuid())
  token      String    @unique
  clientName String    @map("client_name")
  value      Decimal   @db.Decimal(10, 2)
  scope      String    @db.Text
  details    String?   @db.Text
  mode               String    @default("apresentacao") // "apresentacao" | "completa"
  originalPrice      Decimal?  @db.Decimal(10, 2) @map("original_price")
  countdownMinutes   Int       @default(60) @map("countdown_minutes")
  linkedProposalId   String?   @unique @map("linked_proposal_id")
  openedAt            DateTime? @map("opened_at")
  expiresAt           DateTime? @map("expires_at")
  approvedAt          DateTime? @map("approved_at")
  reminderSentAt      DateTime? @map("reminder_sent_at")
  reactivationSentAt  DateTime? @map("reactivation_sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  leads          PresentationProposalLead[]
  linkedProposal Proposal? @relation(fields: [linkedProposalId], references: [id])

  @@map("presentation_proposals")
}

model PresentationProposalLead {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  email      String
  capturedAt DateTime @default(now()) @map("captured_at")

  proposal PresentationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("presentation_proposal_leads")
}

model QuoteLead {
  id          String   @id @default(uuid())
  token       String?  @unique @map("token")
  name        String
  email       String
  projectType String   @map("project_type")
  pageCount   Int?     @map("page_count")
  segment     String
  hasAdmin    Boolean  @default(false) @map("has_admin")
  hasLogo     Boolean  @default(true) @map("has_logo")
  hasDomain   Boolean  @default(true) @map("has_domain")
  hasHosting  Boolean  @default(false) @map("has_hosting")
  totalValue  Decimal  @db.Decimal(10, 2) @map("total_value")
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("quote_leads")
}

model EmailOptOut {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_opt_outs")
}

model ImpersonationLog {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  clientId  String    @map("client_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@map("impersonation_logs")
}
