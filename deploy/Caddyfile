# Caddy emite e renova o SSL (Let's Encrypt) sozinho assim que o DNS apontar para a VPS.

topsitebr.com.br {
	encode zstd gzip
	reverse_proxy topsites:3000
}

www.topsitebr.com.br {
	redir https://topsitebr.com.br{uri} permanent
}

