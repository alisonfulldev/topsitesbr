# Copiar os valores de Produção da Vercel (Settings → Environment Variables).
# Na VPS este arquivo vira /opt/apps/topsites.env. Sem aspas nos valores.

DATABASE_URL=
DIRECT_URL=

NEXTAUTH_URL=https://topsitebr.com.br
NEXTAUTH_SECRET=
CRON_SECRET=

NEXT_PUBLIC_APP_URL=https://topsitebr.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Obrigatório "supabase": o disco do container é apagado a cada atualização
STORAGE_DRIVER=supabase

PAYMENT_DRIVER=
ASAAS_API_KEY=
ASAAS_ENV=
ASAAS_WEBHOOK_TOKEN=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
COMPANY_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_BUSINESS_NUMBER=

# WhatsApp com IA (ver .env.example para o que é cada uma)
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_TOKEN=
ANTHROPIC_API_KEY=
WHATSAPP_AI_MODEL=
GOOGLE_PAGESPEED_API_KEY=
