# Imagem só de execução, usada pelo GitHub Actions (.github/workflows/deploy.yml).
# O `next build` roda uma vez no runner (é a parte pesada); aqui só copiamos o
# resultado, então a mesma imagem sai para x86 e ARM sem recompilar.
# Para build completo dentro do Docker (sem Actions), use o Dockerfile normal.

FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

COPY public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
# Engines do Prisma das duas arquiteturas (ver binaryTargets no schema.prisma)
COPY node_modules/.prisma ./node_modules/.prisma
COPY scripts/run-cron.mjs ./scripts/run-cron.mjs

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
