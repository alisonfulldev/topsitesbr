# ─── Supabase / Prisma ────────────────────────────────────────────────────────
# Pooled connection (usado pela aplicação via Prisma)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (usado pelo Prisma Migrate)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="seu-secret-gerado-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Supabase Client ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-privada"

# ─── Asaas ────────────────────────────────────────────────────────────────────
ASAAS_API_KEY="$sua_api_key_asaas"
ASAAS_WEBHOOK_TOKEN="seu-token-secreto-para-validar-webhooks"
# sandbox = testes sem dinheiro real | production = dinheiro real
ASAAS_ENV="sandbox"

# ─── Resend (e-mail) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Prospecção: "Signing secret" (whsec_...) do webhook criado em resend.com/webhooks
# apontando para https://SEU_DOMINIO/api/webhooks/resend
RESEND_WEBHOOK_SECRET=""
# Deve ser um domínio verificado no Resend. No sandbox use: onboarding@resend.dev
EMAIL_FROM="Painel de Sites <noreply@seudominio.com.br>"

# ─── WhatsApp (Cloud API em coexistência com o app WhatsApp Business) ─────────
# meta = direto na Meta | 360dialog = provedor oficial
WHATSAPP_PROVIDER="meta"
# Meta: token permanente de System User | 360dialog: API key
WHATSAPP_TOKEN="seu-token-whatsapp-business-api"
# Meta: ID do número (Phone number ID) no WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
# Meta: chave secreta do app (valida a assinatura do webhook)
WHATSAPP_APP_SECRET=""
# Meta: texto livre que você digita ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=""
# 360dialog (não assina o webhook): URL do webhook leva ?token=ESTE_VALOR
WHATSAPP_WEBHOOK_TOKEN=""
# Número do WhatsApp Business (somente dígitos, com DDI): ex: 5511999999999
WHATSAPP_BUSINESS_NUMBER="55119XXXXXXXX"

# ─── IA (Claude) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Opcional: modelo usado no WhatsApp (padrão claude-haiku-5-5, o mais barato)
WHATSAPP_AI_MODEL=""

# ─── Storage ──────────────────────────────────────────────────────────────────
# local     → salva em public/uploads/ (zero config, ideal para dev)
# supabase  → Supabase Storage (produção)
STORAGE_DRIVER="local"

# ─── Pagamentos ───────────────────────────────────────────────────────────────
# mock  → sem chamadas externas (dev)
# asaas → Asaas real (requer ASAAS_API_KEY preenchido)
PAYMENT_DRIVER="mock"
